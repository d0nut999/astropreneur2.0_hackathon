# App
APP_ENV=dev
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///./data/hireguard.db

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM (OpenAI-compatible)
# Free key: https://console.groq.com -> API Keys. NEVER commit your real .env
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODELS=llama-3.3-70b-versatile
LLM_TEMPERATURE=0
LLM_CACHE_ENABLED=true
LLM_MAX_ATTEMPTS=2

# Email (Mailpit in dev)
# Mailpit = fake mail server for the demo (web inbox: http://localhost:8025)
# Running without Docker? use localhost instead of mailpit.
SMTP_HOST=localhost
SMTP_PORT=1025
# Optional: read a REAL mailbox instead of Mailpit (e.g. a test Gmail with an app password)
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
HR_MAILBOX=hr@fictional-company.test

# Limits
MAX_UPLOAD_MB=5
MAX_VIDEO_MB=100
PORTAL_TOKEN_TTL_HOURS=72

# Email triage
# Senders whose emails are always treated as important (emails or @domains, comma-separated)
VIP_SENDERS=director@fictional-company.test,ceo@fictional-company.test
DEMO_EMAILS_DIR=./demo_data/emails
MAILPIT_API_URL=http://localhost:8025

# Link sent to candidates for the written interview
FRONTEND_URL=http://localhost:5173
